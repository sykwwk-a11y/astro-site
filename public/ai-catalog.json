{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "name": "essence-design-office-catalog",
    "version": "1.0.0",
    "description": "ESSENCE Design OfficeのAI最適化カタログ",
    "entries": [
      {
        "type": "mcp-tool",
        "name": "get_services_and_pricing",
        "description": "ホームページ制作、運用・広報支援などのプランや基本料金、制作の流れなどの情報を取得します。",
        "parameters": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "type": "mcp-tool",
        "name": "submit_inquiry",
        "description": "無料ホームページ診断、HP・LP制作のご相談、広報のご相談などのお問い合わせを送信します。",
        "parameters": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "お名前"
            },
            "email": {
              "type": "string",
              "description": "メールアドレス"
            },
            "inquiry_type": {
              "type": "string",
              "enum": [
                "無料ホームページ診断",
                "ホームページ・LP制作のご相談",
                "広報のご相談"
              ],
              "description": "お問合せ内容の選択肢"
            },
            "message": {
              "type": "string",
              "description": "お問い合わせ詳細"
            },
            "privacy_policy_agree": {
              "type": "boolean",
              "description": "プライバシーポリシーへの同意"
            }
          },
          "required": [
            "name",
            "email",
            "inquiry_type",
            "message",
            "privacy_policy_agree"
          ]
        }
      }
    ]
  }