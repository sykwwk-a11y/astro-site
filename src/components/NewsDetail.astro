---
import '../styles/global.css';
import { formatNewsDate, type News } from '../lib/microcms';

interface Props {
  post: News;
}

const { post } = Astro.props;
const dateLabel = formatNewsDate(post.publishedAt);
---

<article class="bg-white px-4 py-16 !pb-0 md:px-8 md:py-20 lg:px-12">
  <div class="mx-auto max-w-3xl">
    
    <header class="mt-10">
      {
        post.category.length > 0 && (
          <p class="text-sm text-neutral-500">{post.category.join('、')}</p>
        )
      }
      <h1 class="mt-3 text-h1">{post.title}</h1>
      {
        post.publishedAt && (
          <time datetime={post.publishedAt} class="mt-4 block text-sm text-neutral-500">
            {dateLabel}
          </time>
        )
      }
    </header>

    {
      post.eyecatch && (
        <img
          src={post.eyecatch.url}
          alt={post.eyecatch.alt || ''}
          width={post.eyecatch.width}
          height={post.eyecatch.height}
          class="mt-8 w-full"
        />
      )
    }

    <div class="news-body mt-8 text-body" set:html={post.content} />

    <p class="mt-10 text-body">
      ESSENCE Design Office 藤田<br />
      広報・Web制作のご相談はお気軽にご連絡ください。
    </p>

    <div class="mt-12 text-center">
      <a href="/news" class="btn-normal">お知らせ一覧に戻る</a>
    </div>
  </div>
</article>
