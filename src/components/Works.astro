---
import '../styles/global.css';
import { Image } from 'astro:assets';
import lpImage from '../assets/lp-board.webp';
import hpImage from '../assets/HP-board.webp';

const works = [
  {
    title: 'LP制作工程',
    image: lpImage,
    alt: 'スマートフォンに表示されたランディングページの制作画面',
    href: '/works/lp',
  },
  {
    title: 'ホームページ制作工程',
    image: hpImage,
    alt: 'ESSENCE Design Officeのホームページ制作イメージ',
    href: '/works/homepage',
  },
];
---

<section id="works" class="bg-white px-4 py-16 md:px-8 md:py-20 lg:px-12">
  <div class="mx-auto max-w-6xl">
    <h2 class="text-h2">制作工程・実績</h2>
    <p class="mt-4 text-body">
      LP・HP制作の実績紹介について、工程を含めご紹介します。
    </p>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {
        works.map((work) => (
          <article>
            {work.href ? (
              <a href={work.href} class="group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4">
                <h3 class="inline-block transform text-h3 transition duration-300 group-hover:scale-105 group-hover:text-accent">
                  {work.title}
                </h3>
                <Image
                  src={work.image}
                  alt={work.alt}
                  class="mt-4 w-full origin-center transform rounded-xl transition duration-300 ease-in-out group-hover:scale-105"
                />
              </a>
            ) : (
              <>
                <h3 class="text-h3">{work.title}</h3>
                <Image src={work.image} alt={work.alt} class="mt-4 w-full rounded-xl" />
              </>
            )}
          </article>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href="https://portfolio-fujitasayaka.studio.site/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-normal gap-2"
      >
        他の制作実績を見る
        <span class="material-icons text-base leading-none" aria-hidden="true">open_in_new</span>
      </a>
      <p class="mt-3 text-caption text-neutral/60">外部サイトに移動します</p>
    </div>
  </div>
</section>
