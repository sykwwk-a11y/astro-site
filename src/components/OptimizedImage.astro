---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** 書き出す最大幅（px）。表示幅の2倍程度を上限にする */
  width: number;
  sizes: string;
  class?: string;
  pictureClass?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  quality?: number;
  layout?: 'constrained' | 'full-width' | 'fixed' | 'none';
  fit?: 'cover' | 'contain' | 'fill' | 'none' | 'scale-down';
  position?: string;
}

const {
  src,
  alt,
  width,
  sizes,
  class: className,
  pictureClass = 'block w-full',
  loading = 'lazy',
  fetchpriority,
  quality = 70,
  layout = 'constrained',
  fit = 'cover',
  position = 'center',
} = Astro.props;

const maxWidth = Math.max(1, Math.min(width, src.width));
const height = Math.max(1, Math.round(maxWidth * (src.height / src.width)));
const steps = [480, 640, 768, 1024, 1280, 1600, 1920].filter((step) => step < maxWidth);
const widths = [...steps, maxWidth];
---

<Picture
  src={src}
  alt={alt}
  width={maxWidth}
  height={height}
  sizes={sizes}
  widths={widths}
  layout={layout}
  fit={fit}
  position={position}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  quality={quality}
  loading={loading}
  fetchpriority={fetchpriority ?? (loading === 'eager' ? 'high' : 'auto')}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  class={className}
  pictureAttributes={{ class: pictureClass }}
/>
