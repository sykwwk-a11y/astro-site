---
import '../styles/global.css';

const topics = [
  '無料ホームページ診断',
  'ホームページ・LP制作のご相談',
  '販促デザイン制作のご相談',
  '広報のご相談',
];
---

<section id="contact" class="bg-base px-4 py-16 !pb-0 md:px-8 md:py-20 lg:px-12">
  <div class="mx-auto max-w-2xl">
    <h1 class="text-h1">お問合せ</h1>
    <p class="mt-8 text-body">
      制作のご相談やご質問など、下記フォームよりお気軽にご相談ください。
    </p>

    <form
      id="contact-form"
      class="mt-8"
      action="https://ssgform.com/s/oiyucboxUxXP"
      method="post"
    >
      <div>
        <label for="name" class="text-sm">お名前</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          placeholder="お名前"
          class="mt-2 w-full rounded-md border border-main-2 bg-white px-3 py-3 text-sm text-text placeholder:text-text-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
        />
      </div>

      <div class="mt-8">
        <label for="email" class="text-sm">メールアドレス</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="example@abc.com"
          class="mt-2 w-full rounded-md border border-main-2 bg-white px-3 py-3 text-sm text-text placeholder:text-text-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
        />
      </div>

      <fieldset class="mt-8">
        <legend class="text-sm">お問合せ内容</legend>
        <div class="mt-3 space-y-3">
          {
            topics.map((topic) => (
              <label class="flex items-center gap-3 text-sm">
                <input
                  type="radio"
                  name="お問合せ内容"
                  value={topic}
                  required
                  class="radio radio-xs　radio-neutral"
                />
                {topic}
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="mt-8">
        <label for="message" class="text-sm">お問い合わせ詳細</label>
        <textarea
          id="message"
          name="message"
          required
          rows="8"
          placeholder="お問い合わせ内容は、こちらに記載ください。"
          aria-describedby="message-error"
          class="mt-2 w-full rounded-md border border-main-2 bg-white px-3 py-3 text-sm text-text placeholder:text-text-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
        ></textarea>
        <p id="message-error" class="mt-2 text-sm text-error" role="alert" hidden>
          ひらがな、カタカナ、漢字のいずれかを含めてください。
        </p>
      </div>

      <label class="mt-8 flex items-center gap-3 text-sm">
        <input
          type="checkbox"
          name="プライバシーポリシー"
          value="同意する"
          required
          class="checkbox checkbox-sm"
        />
        <span>
          <a href="/policy" target="_blank" rel="noopener noreferrer" class="underline">プライバシーポリシー<span class="sr-only">（新しいタブで開きます）</span></a>に同意する
        </span>
      </label>

      <div class="mt-8">
        <div
          class="g-recaptcha"
          data-sitekey="6LdA2CIuAAAAAFaNQ76CcTiYwkbTidbmDqT81P0d"
          data-callback="onContactCaptchaChange"
          data-expired-callback="onContactCaptchaChange"
          data-error-callback="onContactCaptchaChange"
        ></div>
        <p id="captcha-error" class="mt-2 text-sm text-error" role="alert" hidden>
          確認を完了してから送信してください。
        </p>
      </div>

      <div class="mt-6 text-center">
        <button type="submit" id="contact-submit" class="btn-contact" disabled>
          送信する
        </button>
        <p id="submit-hint" class="mt-3 text-sm text-text-2">
          すべての項目を入力すると送信できます。
        </p>
      </div>
    </form>
  </div>
</section>

<script is:inline src="https://www.google.com/recaptcha/api.js" async defer></script>

<script>
  const form = document.getElementById('contact-form');
  const message = document.getElementById('message');
  const messageError = document.getElementById('message-error');
  const captchaError = document.getElementById('captcha-error');
  const submitButton = document.getElementById('contact-submit');
  const submitHint = document.getElementById('submit-hint');
  const hasJapanese = /[\u3040-\u309F\u30A0-\u30FF\u4E00-\u9FFF\uFF66-\uFF9F]/;

  const textValue = (name: string) => {
    if (!(form instanceof HTMLFormElement)) return '';
    const field = form.elements.namedItem(name);
    if (field instanceof RadioNodeList) return field.value.trim();
    if (field instanceof HTMLInputElement && field.type === 'checkbox') {
      return field.checked ? field.value.trim() : '';
    }
    if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
      return field.value.trim();
    }
    return '';
  };

  const captchaValue = () => {
    if (!(form instanceof HTMLFormElement)) return '';
    const captcha = form.querySelector('[name="g-recaptcha-response"]');
    return captcha instanceof HTMLTextAreaElement ? captcha.value.trim() : '';
  };

  const messageOk = () => message instanceof HTMLTextAreaElement && hasJapanese.test(message.value);

  const isReady = () => {
    if (!(form instanceof HTMLFormElement)) return false;
    const email = form.elements.namedItem('email');
    const emailOk =
      email instanceof HTMLInputElement && email.value.trim().length > 0 && email.checkValidity();

    return (
      textValue('name').length > 0 &&
      emailOk &&
      textValue('お問合せ内容').length > 0 &&
      messageOk() &&
      textValue('プライバシーポリシー').length > 0 &&
      captchaValue().length > 0
    );
  };

  const syncSubmitState = () => {
    const filled = message instanceof HTMLTextAreaElement && message.value.trim().length > 0;
    const japaneseOk = messageOk();
    if (message instanceof HTMLTextAreaElement && messageError) {
      const showError = filled && !japaneseOk;
      messageError.hidden = !showError;
      message.setAttribute('aria-invalid', showError ? 'true' : 'false');
    }

    const ready = isReady();
    if (submitButton instanceof HTMLButtonElement) submitButton.disabled = !ready;
    if (submitHint) submitHint.hidden = ready;
    if (ready && captchaError) captchaError.hidden = true;
  };

  (window as Window & { onContactCaptchaChange?: () => void }).onContactCaptchaChange = () => {
    syncSubmitState();
  };

  form?.addEventListener('input', syncSubmitState);
  form?.addEventListener('change', syncSubmitState);
  syncSubmitState();

  form?.addEventListener('submit', (event) => {
    syncSubmitState();
    if (isReady()) return;

    event.preventDefault();
    const japaneseOk = messageOk();
    const captchaOk = captchaValue().length > 0;
    if (captchaError) captchaError.hidden = captchaOk;
    if (!japaneseOk && message instanceof HTMLTextAreaElement) message.focus();
  });
</script>
